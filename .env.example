# Token from @BotFather
TELEGRAM_TOKEN=
# Channel to listen to: numeric id (-100...) or @username
TELEGRAM_CHANNEL=@mi_canal

AZURA_URL=https://adminradio.rlab.lat
# AzuraCast > My Account > API Keys
AZURA_API_KEY=
AZURA_STATION=rlab_radio
# Folder in the station media where songs are uploaded
AZURA_FOLDER=telegram

# Skip videos longer than this (seconds)
MAX_DURATION=900
# Reply to the channel post when a song is added or skipped
REPLY_IN_CHANNEL=false
